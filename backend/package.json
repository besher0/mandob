{
  "name": "mandob-api",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:bootstrap": "node scripts/bootstrap.js",
    "check": "node --check src/app.js && node --check src/server.js && node --check src/auth.js && node --check src/routes.js",
    "test": "node --test test-v2/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "express": "^5.2.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  }
}
