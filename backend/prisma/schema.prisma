generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  TEAM_MANAGER
  REP
}

enum VisitType {
  DOCTOR
  PHARMACY
  HOSPITAL
}

enum Grade {
  A
  B
  C
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductPriority {
  PRIMARY
  SECONDARY
  SUPPORT
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
  teams     Team[]
  areas     Area[]
  provinces Province[]
  areaGroups AreaGroup[]
  doctors   Doctor[]
  pharmacies Pharmacy[]
  hospitals Hospital[]
  products  Product[]
  visits    Visit[]
  leaves    LeaveRequest[]
  settings  CompanySettings?
  auditLogs AuditLog[]
  doctorImports DoctorImportBatch[]
  doctorVisitGoals DoctorVisitGoal[]
  reportSubmissions RepReportSubmission[]
  cycles Cycle[]
}

model User {
  id             String  @id @default(uuid())
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name           String
  username       String  @unique
  passwordHash   String
  role           Role
  teamId         String?
  team           Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  dailyTarget    Int @default(8)
  annualLeaveBalance Int @default(12)
  active         Boolean @default(true)
  sessions       AuthSession[]
  repAreas       RepArea[]
  specialtyMode String @default("TEAM")
  repSpecialties RepSpecialty[]
  repProducts    RepProduct[]
  visits         Visit[] @relation("RepVisits")
  leaveRequests  LeaveRequest[] @relation("RepLeaves")
  reviewedLeaves LeaveRequest[] @relation("LeaveReviewer")
  managedTeams ManagerTeamAssignment[] @relation("ManagerAssignedTeams")
  auditLogs      AuditLog[]
  submittedReports RepReportSubmission[] @relation("SubmittedRepReports")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([companyId, role])
  @@index([companyId, teamId])
  // Stable order for paginated company/team user directory.
  @@index([companyId,name,id])
}

model AuthSession {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  activeManagerTeamId String?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name String
  managerInstructions String? @db.VarChar(1000)
  provinceId String?
  province Province? @relation(fields:[provinceId],references:[id],onDelete:SetNull)
  users User[]
  managerAssignments ManagerTeamAssignment[]
  products TeamProduct[]
  specialties TeamSpecialty[]
  createdAt DateTime @default(now())
  @@unique([companyId,name])
  @@index([companyId])
  @@index([companyId,provinceId])
}

model ManagerTeamAssignment {
  managerId String
  teamId String
  assignedAt DateTime @default(now())
  manager User @relation("ManagerAssignedTeams", fields: [managerId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@id([managerId, teamId])
  @@index([teamId])
}

model TeamSpecialty {
  teamId String
  specialty String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@id([teamId,specialty])
}

model Province {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  name String
  areas Area[]
  teams Team[]
  areaGroups AreaGroup[]
  createdAt DateTime @default(now())
  @@unique([companyId,name])
  @@index([companyId])
}

model Area {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields: [companyId],references:[id],onDelete:Cascade)
  name String
  city String?
  provinceId String?
  province Province? @relation(fields:[provinceId],references:[id],onDelete:SetNull)
  groupId String?
  group AreaGroup? @relation(fields:[groupId],references:[id],onDelete:SetNull)
  repAreas RepArea[]
  doctors Doctor[]
  doctorAreas DoctorArea[]
  visitTargetsAtVisit VisitTarget[] @relation("VisitTargetRecordedArea")
  pharmacies Pharmacy[]
  hospitals Hospital[]
  createdAt DateTime @default(now())
  @@unique([companyId,name])
  @@index([companyId])
  @@index([companyId,groupId])
  @@index([companyId,provinceId])
}

model AreaGroup {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  provinceId String?
  province Province? @relation(fields:[provinceId],references:[id],onDelete:SetNull)
  name String
  sortOrder Int @default(0)
  areas Area[]
  createdAt DateTime @default(now())
  @@unique([companyId,name])
  @@index([companyId,sortOrder])
  @@index([companyId,provinceId])
}

model RepArea {
  repId String
  areaId String
  rep User @relation(fields: [repId], references:[id],onDelete:Cascade)
  area Area @relation(fields:[areaId],references:[id],onDelete:Cascade)
  @@id([repId,areaId])
  @@index([areaId])
}

model Doctor {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  areaId String
  area Area @relation(fields:[areaId],references:[id],onDelete:Restrict)
  name String
  specialty String
  grade Grade @default(C)
  city String?
  // Soft-archive only: historical visits and foreign keys remain intact.
  active Boolean @default(true)
  targets VisitTarget[]
  doctorAreas DoctorArea[]
  visitGoals DoctorVisitGoal[]
  createdAt DateTime @default(now())
  @@index([companyId,areaId])
  @@index([companyId,name])
  @@index([companyId,active,areaId])
}


model DoctorVisitGoal {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  doctorId String
  doctor Doctor @relation(fields:[doctorId],references:[id],onDelete:Restrict)
  // TEAM => ownerId is Team.id; REP => ownerId is User.id (role REP).
  // Owner is validated by company-scoped API before persistence.
  scope String
  ownerId String
  cycleStart DateTime @db.Date
  cycleEnd DateTime @db.Date
  target Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId,scope,ownerId,doctorId,cycleStart,cycleEnd],map:"DoctorVisitGoal_unique_scope_owner_doctor_cycle")
  @@index([companyId,cycleStart,cycleEnd])
  @@index([companyId,scope,ownerId])
}

model DoctorImportBatch {
  id String @id
  companyId String
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  contentHash String
  result Json
  createdAt DateTime @default(now())
  @@index([companyId,createdAt])
}

model DoctorArea {
  doctorId String
  areaId String
  doctor Doctor @relation(fields:[doctorId],references:[id],onDelete:Cascade)
  area Area @relation(fields:[areaId],references:[id],onDelete:Restrict)
  @@id([doctorId,areaId])
  @@index([areaId,doctorId])
}

model Pharmacy {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  areaId String
  area Area @relation(fields:[areaId],references:[id],onDelete:Restrict)
  name String
  target Int @default(4)
  grade Grade @default(A)
  kind String @default("مستقلة")
  active Boolean @default(true)
  targets VisitTarget[]
  createdAt DateTime @default(now())
  @@index([companyId,areaId])
  @@index([companyId,active,areaId])
}

model Hospital {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  areaId String
  area Area @relation(fields:[areaId],references:[id],onDelete:Restrict)
  name String
  category String @default("خاص")
  specialty String @default("عام")
  target Int @default(4)
  active Boolean @default(true)
  targets VisitTarget[]
  createdAt DateTime @default(now())
  @@index([companyId,areaId])
  @@index([companyId,active,areaId])
}

model Product {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  name String
  activeIngredient String?
  priority ProductPriority @default(SUPPORT)
  targetSpecialties String[] @default([])
  active Boolean @default(true)
  repProducts RepProduct[]
  teamProducts TeamProduct[]
  visitProducts VisitProduct[]
  @@unique([companyId,name])
}

model RepSpecialty {
  repId String
  specialty String
  rep User @relation(fields:[repId],references:[id],onDelete:Cascade)
  @@id([repId,specialty])
}

model RepProduct {
  repId String
  productId String
  rep User @relation(fields:[repId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@id([repId,productId])
}

model TeamProduct {
  teamId String
  productId String
  team Team @relation(fields:[teamId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@id([teamId,productId])
}

model Visit {
  id String @id @default(uuid())
  clientVisitId String @unique
  companyId String
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  repId String
  rep User @relation("RepVisits",fields:[repId],references:[id],onDelete:Restrict)
  // Immutable attribution: the rep's team when the tour was completed.
  // Scalar snapshot intentionally remains valid if an old team is later archived.
  teamIdAtVisit String?
  type VisitType
  visitDate DateTime @db.Date
  note String? @db.VarChar(2000)
  latitude Float
  longitude Float
  locationAccuracy Float
  locationCapturedAt DateTime
  createdAt DateTime @default(now())
  targets VisitTarget[]
  products VisitProduct[]
  @@index([companyId,visitDate])
  @@index([repId,visitDate])
  @@index([companyId,teamIdAtVisit,visitDate])
  // Prefixes match current visit-history filters; trailing columns stabilize paging.
  @@index([companyId,visitDate,createdAt,id])
  @@index([repId,visitDate,createdAt,id])
  @@index([companyId,teamIdAtVisit,visitDate,createdAt,id])
}

model VisitTarget {
  id String @id @default(uuid())
  visitId String
  visit Visit @relation(fields:[visitId],references:[id],onDelete:Cascade)
  doctorId String?
  doctor Doctor? @relation(fields:[doctorId],references:[id],onDelete:Restrict)
  pharmacyId String?
  pharmacy Pharmacy? @relation(fields:[pharmacyId],references:[id],onDelete:Restrict)
  hospitalId String?
  hospital Hospital? @relation(fields:[hospitalId],references:[id],onDelete:Restrict)
  // Explicit visit-time area attribution. NULL denotes historical tours with
  // no trustworthy per-target area information; never backfill by current links.
  areaIdAtVisit String?
  areaAtVisit Area? @relation("VisitTargetRecordedArea",fields:[areaIdAtVisit],references:[id],onDelete:Restrict)
  @@index([areaIdAtVisit,doctorId])
  @@unique([visitId,doctorId])
  @@unique([visitId,pharmacyId])
  @@unique([visitId,hospitalId])
  @@index([doctorId])
  @@index([pharmacyId])
  @@index([hospitalId])
}

model VisitProduct {
  visitId String
  productId String
  quantity Int @default(0)
  visit Visit @relation(fields:[visitId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  @@id([visitId,productId])
  @@index([productId,visitId])
}

model LeaveRequest {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  repId String
  rep User @relation("RepLeaves",fields:[repId],references:[id],onDelete:Restrict)
  type String
  fromDate DateTime @db.Date
  toDate DateTime @db.Date
  reason String?
  attachment LeaveAttachment?
  status LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedBy User? @relation("LeaveReviewer",fields:[reviewedById],references:[id],onDelete:SetNull)
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([companyId,status])
  @@index([repId,fromDate])
  // Efficient overlap checks for active leave requests by one representative.
  @@index([repId,status,fromDate,toDate])
  // Support company and representative history ordered by creation date.
  @@index([companyId,createdAt,id])
  @@index([repId,createdAt,id])
}

model LeaveAttachment {
  id String @id @default(uuid())
  leaveId String @unique
  leave LeaveRequest @relation(fields:[leaveId],references:[id],onDelete:Cascade)
  fileName String @db.VarChar(120)
  mimeType String @db.VarChar(40)
  byteLength Int
  data Bytes
  createdAt DateTime @default(now())
}

model Cycle {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  createdAt DateTime @default(now())
  @@unique([companyId,startDate,endDate])
  @@index([companyId,startDate,endDate])
}

model CompanySettings {
  companyId String @id
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  cycleStart DateTime? @db.Date
  cycleEnd DateTime? @db.Date
  frequencyA Int @default(4)
  frequencyB Int @default(2)
  frequencyC Int @default(1)
  annualLeaveBalance Int @default(12)
  targetACoverage Int @default(80)
  managerInstructions String? @db.VarChar(1000)
  workingDays Int[] @default([0,1,2,3,4,6])
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(uuid())
  companyId String?
  company Company? @relation(fields:[companyId],references:[id],onDelete:SetNull)
  actorId String?
  actor User? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  action String
  entity String
  entityId String?
  createdAt DateTime @default(now())
  @@index([companyId,createdAt])
}

// Server-generated, immutable report snapshots submitted by representatives.
model RepReportSubmission {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  repId String
  rep User @relation("SubmittedRepReports",fields:[repId],references:[id],onDelete:Restrict)
  teamIdAtSubmission String?
  fromDate DateTime @db.Date
  toDate DateTime @db.Date
  snapshot Json
  createdAt DateTime @default(now())
  @@index([companyId,createdAt,id])
  @@index([companyId,teamIdAtSubmission,createdAt])
  @@index([repId,createdAt])
}
